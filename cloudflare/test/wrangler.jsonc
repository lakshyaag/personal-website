{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "personal-journal-test-only",
	"main": "../src/index.ts",
	"compatibility_date": "2026-03-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "personal-journal-local",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "../migrations"
		}
	],
	"r2_buckets": [
		{ "binding": "PHOTOS", "bucket_name": "personal-journal-local-private" }
	],
	"images": { "binding": "IMAGES" },
	"queues": {
		"producers": [
			{ "binding": "PHOTO_QUEUE", "queue": "personal-journal-test-photos" }
		],
		"consumers": [
			{
				"queue": "personal-journal-test-photos",
				"max_batch_size": 5,
				"max_retries": 5
			}
		]
	},
	"vars": { "LOCAL_UPLOADS": "true" }
}
