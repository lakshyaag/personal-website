NEXT_PUBLIC_ASSET_BASE_URL="https://<r2-public-host>/site-assets"
R2_ACCOUNT_ID="<cloudflare-account-id>"
R2_ACCESS_KEY_ID="<r2-access-key-id>"
R2_SECRET_ACCESS_KEY="<r2-secret-access-key>"
R2_BUCKET="site-assets"

# GitHub OAuth: use separate apps for localhost and production.
# Callback: http://localhost:3000/api/auth/callback/github
AUTH_URL="http://localhost:3000"
AUTH_SECRET="REPLACE_WITH_RANDOM_64_HEX_CHARACTERS"
AUTH_GITHUB_ID="REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID"
AUTH_GITHUB_SECRET="REPLACE_WITH_GITHUB_OAUTH_CLIENT_SECRET"
ADMIN_GITHUB_ID="REPLACE_WITH_YOUR_NUMERIC_GITHUB_USER_ID"

# Server-to-server credential. Must equal the Worker's WORKER_API_SECRET.
CLOUDFLARE_WORKER_URL="http://localhost:8787"
CLOUDFLARE_WORKER_SECRET="REPLACE_WITH_A_SECOND_RANDOM_64_HEX_SECRET"

# true ONLY for next dev + a localhost Worker. Always false on Vercel.
# This lets local R2 work without Cloudflare credentials.
LOCAL_WORKER_UPLOADS="true"

# Shared private bucket for all admin features. Must never be the public site-assets bucket.
# Scope R2 credentials to this private bucket. Reuse account ID above.
PRIVATE_R2_BUCKET="personal-website-production-private"
PRIVATE_R2_ACCESS_KEY_ID="REPLACE_WITH_PRIVATE_BUCKET_ACCESS_KEY_ID"
PRIVATE_R2_SECRET_ACCESS_KEY="REPLACE_WITH_PRIVATE_BUCKET_SECRET_ACCESS_KEY"
